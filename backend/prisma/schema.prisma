// Nexus domain schema.
//
// Tenancy hierarchy: Organization → Location → operational data.
// Rules that hold across the whole schema:
//   - every operational table carries organizationId; a nullable locationId
//     means "shared across the organization"
//   - a unique name or number is unique within its organization; global keys
//     are the ones that identify an account, a session, an invitation or a
//     billing record (email, slug, tokens, Stripe ids)
//   - ids are cuid strings
//   - RecipeSection is a section inside a recipe; RecipeComponent is a nested
//     recipe (a self-relation on Recipe)
//
// The datasource URL is supplied by prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Tenancy: organizations, locations, users and invitations
// ============================================================================

enum SubscriptionStatus {
  trial
  active
  past_due
  canceled
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  subscriptionStatus   SubscriptionStatus @default(trial)
  trialEndsAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  planId               String?
  currentPeriodEnd     DateTime?
  billingSeats         Int?

  ownerName  String?
  ownerEmail String  @unique
  phone      String?
  address    String?
  city       String?
  state      String?
  zipCode    String?
  country    String  @default("US")
  timezone   String  @default("America/New_York")
  currency   String  @default("USD")
  dateFormat String  @default("MM/DD/YYYY")

  foodCostTargetPct Decimal @default(30) @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations         Location[]
  users             User[]
  invitations       Invitation[]
  vendors           Vendor[]
  categories        Category[]
  ingredients       Ingredient[]
  recipes           Recipe[]
  menuItems         MenuItem[]
  menus             Menu[]
  sales             Sale[]
  productions       Production[]
  wasteEntries      WasteEntry[]
  transactions      InventoryTransaction[]
  priceHistory      IngredientPriceHistory[]
  invoices          Invoice[]
  documents         Document[]
  extractions       Extraction[]
  ingredientAliases IngredientAlias[]
  menuItemAliases   MenuItemAlias[]
  unitConversions   UnitConversion[]
  vendorProducts    VendorProduct[]
  purchaseDrafts    PurchaseDraft[]
  billingEvents     BillingEvent[]

  @@index([subscriptionStatus])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean @default(true)
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userAccess      UserLocation[]
  perLocation     IngredientLocationSettings[]
  stock           IngredientLocationStock[]
  priceHistory    IngredientPriceHistory[]
  recipes         Recipe[]
  menuItems       MenuItem[]
  menus           MenuOnLocation[]
  sales           Sale[]
  productions     Production[]
  purchaseDrafts  PurchaseDraft[]
  wasteEntries    WasteEntry[]
  transactions    InventoryTransaction[]
  invoices        Invoice[]
  documents       Document[]
  menuItemAliases MenuItemAlias[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum Role {
  viewer
  staff
  manager
  admin
  owner
}

model User {
  id             String @id @default(cuid())
  organizationId String

  email          String  @unique
  hashedPassword String
  fullName       String
  phone          String?

  role            Role    @default(viewer)
  isPlatformAdmin Boolean @default(false)

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationAccess  UserLocation[]
  sentInvitations Invitation[]
  sessions        UserSession[]

  @@index([organizationId])
}

model UserSession {
  id     String @id @default(cuid())
  userId String

  refreshTokenHash  String   @unique
  previousTokenHash String?  @unique
  userAgent         String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  expiresAt         DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserLocation {
  id         String @id @default(cuid())
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Invitation {
  id             String @id @default(cuid())
  organizationId String

  email       String
  role        Role             @default(viewer)
  token       String           @unique
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  locationIds Json             @default("[]")

  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

// ============================================================================
// Reference data: vendors and categories
// ============================================================================

enum VendorStatus {
  active
  inactive
}

model Vendor {
  id             String @id @default(cuid())
  organizationId String

  name    String
  contact String?
  phone   String?
  status  VendorStatus @default(active)
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients    Ingredient[]
  perLocation    IngredientLocationSettings[]
  priceHistory   IngredientPriceHistory[]
  invoices       Invoice[]
  products       VendorProduct[]
  purchaseDrafts PurchaseDraft[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Category {
  id             String @id @default(cuid())
  organizationId String

  name String
  kind CategoryKind @default(ingredient)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]
  recipes      Recipe[]
  menuItems    MenuItem[]

  @@unique([organizationId, name, kind])
  @@index([organizationId])
}

enum CategoryKind {
  ingredient
  recipe
  menu
}

// ============================================================================
// Ingredients, stock and per-location pricing
// ============================================================================

model Ingredient {
  id             String @id @default(cuid())
  organizationId String

  name        String
  unit        String
  costPerUnit Decimal @default(0) @db.Decimal(12, 4)
  sku         String?
  notes       String?

  onHand       Decimal @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal @default(0) @db.Decimal(12, 3)
  reorderQty   Decimal @default(0) @db.Decimal(12, 3)

  isActive Boolean @default(true)

  categoryId String?
  vendorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor         Vendor?                      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  perLocation    IngredientLocationSettings[]
  stock          IngredientLocationStock[]
  priceHistory   IngredientPriceHistory[]
  usedIn         RecipeIngredient[]
  draftLines     PurchaseDraftLine[]
  transactions   InventoryTransaction[]
  wasteEntries   WasteEntry[]
  invoiceItems   InvoiceItem[]
  aliases        IngredientAlias[]
  conversions    UnitConversion[]
  vendorProducts VendorProduct[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, vendorId])
}

model IngredientLocationSettings {
  id           String @id @default(cuid())
  ingredientId String
  locationId   String

  costPerUnit  Decimal? @db.Decimal(12, 4)
  reorderLevel Decimal? @db.Decimal(12, 3)
  vendorId     String?
  vendorSku    String?

  updatedAt DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([ingredientId, locationId])
  @@index([locationId])
  @@index([vendorId])
}

model IngredientLocationStock {
  id           String @id @default(cuid())
  ingredientId String
  locationId   String

  onHand Decimal @default(0) @db.Decimal(12, 3)

  updatedAt DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locationId])
  @@index([locationId])
}

model IngredientPriceHistory {
  id             String  @id @default(cuid())
  organizationId String
  ingredientId   String
  vendorId       String?
  locationId     String?

  costPerUnit Decimal  @db.Decimal(12, 4)
  source      String // 'manual' | 'receipt'
  recordedAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, ingredientId, recordedAt])
  @@index([organizationId, vendorId])
}

enum TxType {
  RECEIVE
  USE
  ADJUST
  WASTE
  COUNT
  SALE
}

model InventoryTransaction {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  ingredientId String
  type         TxType
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  cost         Decimal @default(0) @db.Decimal(12, 2)
  notes        String?
  wasteReason  String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([organizationId, locationId, createdAt])
  @@index([ingredientId])
}

// ============================================================================
// Recipes: ingredients, sections, nested recipes and instructions
// ============================================================================

enum RecipeStatus {
  draft
  published
  archived
}

model Recipe {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  name        String
  description String?
  status      RecipeStatus @default(published)

  portions        Int      @default(1)
  yieldAmount     Decimal? @db.Decimal(12, 3)
  yieldUnit       String?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  notes           String?

  totalCost         Decimal  @default(0) @db.Decimal(12, 4)
  targetFoodCostPct Decimal? @db.Decimal(5, 2)

  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  ingredients  RecipeIngredient[]
  sections     RecipeSection[]
  instructions Instruction[]
  components   RecipeComponent[]  @relation("parent")
  usedIn       RecipeComponent[]  @relation("component")
  menuUsage    MenuItemRecipe[]
  productions  Production[]
  conversions  UnitConversion[]

  @@unique([organizationId, locationId, name])
  @@index([organizationId, locationId])
}

model RecipeSection {
  id       String @id @default(cuid())
  recipeId String
  name     String
  order    Int    @default(0)

  recipe       Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  instructions Instruction[]

  @@index([recipeId])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  sectionId    String?
  ingredientId String

  quantity Decimal @db.Decimal(12, 3)
  unit     String
  prepNote String? // "diced", "thinly sliced"
  order    Int     @default(0)

  recipe     Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  section    RecipeSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeComponent {
  id          String @id @default(cuid())
  parentId    String
  componentId String

  quantity Decimal @db.Decimal(12, 3)
  unit     String
  prepNote String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  parent    Recipe @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  component Recipe @relation("component", fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([parentId, componentId])
  @@index([componentId])
}

model Instruction {
  id        String  @id @default(cuid())
  recipeId  String
  sectionId String?

  stepNumber Int
  text       String

  recipe  Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  section RecipeSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([recipeId, sectionId, stepNumber])
}

// ============================================================================
// Menu: composite items built from recipes and portions
// ============================================================================

model MenuItem {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  name     String
  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)

  cost Decimal @default(0) @db.Decimal(12, 4)

  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipes      MenuItemRecipe[]
  saleItems    SaleItem[]
  aliases      MenuItemAlias[]
  onMenus      MenuItemOnMenu[]

  @@unique([organizationId, locationId, name])
  @@index([organizationId, locationId])
}

model Menu {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItemOnMenu[]
  locations    MenuOnLocation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MenuItemOnMenu {
  id         String @id @default(cuid())
  menuId     String
  menuItemId String

  sortOrder Int @default(0)

  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuId, menuItemId])
  @@index([menuId])
}

model MenuOnLocation {
  id         String @id @default(cuid())
  menuId     String
  locationId String

  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([menuId, locationId])
  @@index([locationId])
}

model MenuItemRecipe {
  id         String @id @default(cuid())
  menuItemId String
  recipeId   String

  portions Decimal @default(1) @db.Decimal(8, 3)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, recipeId])
  @@index([recipeId])
}

// ============================================================================
// Vendor invoices: written by hand or by confirming an extracted document
// ============================================================================

enum InvoiceStatus {
  draft
  confirmed
}

model Invoice {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?
  vendorId       String?
  vendorName     String?

  number      String?
  invoiceDate DateTime
  dueDate     DateTime?

  status   InvoiceStatus @default(draft)
  subtotal Decimal       @default(0) @db.Decimal(12, 2)
  tax      Decimal       @default(0) @db.Decimal(12, 2)
  total    Decimal       @default(0) @db.Decimal(12, 2)

  documentKey String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]

  @@unique([organizationId, vendorId, number])
  @@index([organizationId, locationId, invoiceDate])
  @@index([vendorId])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  ingredientId String?
  description  String
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  unitPrice    Decimal @db.Decimal(12, 4)
  lineTotal    Decimal @db.Decimal(12, 2)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([ingredientId])
}

// ============================================================================
// Operations: sales, production and waste
// ============================================================================

model Sale {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  date  DateTime
  notes String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items        SaleItem[]

  @@index([organizationId, locationId, date])
}

model SaleItem {
  id         String @id @default(cuid())
  saleId     String
  menuItemId String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 4)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([menuItemId])
}

model Production {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  recipeId String
  quantity Decimal  @db.Decimal(12, 3)
  unit     String
  cost     Decimal  @default(0) @db.Decimal(12, 4)
  madeBy   String?
  date     DateTime

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([organizationId, locationId, date])
}

model WasteEntry {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  ingredientId String
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String
  reason       String // spoilage | overproduction | trim | expired | other
  value        Decimal  @default(0) @db.Decimal(12, 2)
  date         DateTime
  notes        String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([organizationId, locationId, date])
}

// ============================================================================
// Document ingestion: uploads, background extraction and review/confirm
// ============================================================================

enum DocumentType {
  invoice
  recipe
  menu
  sales
}

enum DocumentStatus {
  queued
  processing
  requires_review
  confirmed
  partially_processed
  failed
}

model Document {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?

  type     DocumentType
  fileKey  String
  fileName String
  mimeType String
  size     Int

  status DocumentStatus @default(queued)
  error  String?
  jobId  String?

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  extractions  Extraction[]

  @@index([organizationId, locationId, createdAt])
  @@index([organizationId, status])
}

model Extraction {
  id             String @id @default(cuid())
  organizationId String
  documentId     String

  payload    Json
  confidence Float?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
}

model IngredientAlias {
  id             String  @id @default(cuid())
  organizationId String
  ingredientId   String?

  rawName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, rawName])
  @@index([organizationId, ingredientId])
}

model VendorProduct {
  id             String  @id @default(cuid())
  organizationId String
  vendorId       String
  ingredientId   String?

  name     String
  sku      String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, vendorId, name])
  @@index([organizationId, ingredientId])
  @@index([vendorId])
}

model MenuItemAlias {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?
  menuItemId     String?

  rawName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@unique([organizationId, locationId, rawName])
  @@index([organizationId, menuItemId])
  @@index([locationId])
}

// ============================================================================
// Billing: what the payment provider told us, once
// ============================================================================

model BillingEvent {
  id             String @id
  organizationId String

  type       String
  occurredAt DateTime @default(now())
  receivedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt])
  @@index([organizationId, occurredAt])
}

// ============================================================================
// Purchasing: a recommendation becomes a draft order a person reviews and approves
// ============================================================================

enum PurchaseDraftStatus {
  draft
  approved
}

model PurchaseDraft {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String
  vendorId       String?

  status  PurchaseDraftStatus @default(draft)
  note    String?
  days    Int
  horizon Int

  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  lines        PurchaseDraftLine[]

  @@index([organizationId, locationId, status])
  @@index([vendorId])
}

model PurchaseDraftLine {
  id           String @id @default(cuid())
  draftId      String
  ingredientId String

  quantity  Decimal  @db.Decimal(12, 3)
  unit      String
  unitPrice Decimal? @db.Decimal(12, 4)
  suggested Decimal  @default(0) @db.Decimal(12, 3)
  onHand    Decimal  @default(0) @db.Decimal(12, 3)

  draft      PurchaseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([draftId, ingredientId])
  @@index([ingredientId])
}

// ============================================================================
// Unit conversion: bridging a recipe's unit to the unit its ingredient is priced in
// ============================================================================

model UnitConversion {
  id             String  @id @default(cuid())
  organizationId String
  ingredientId   String?
  recipeId       String?

  fromUnit String
  toUnit   String
  factor   Decimal @db.Decimal(18, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipe       Recipe?      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recipeId, ingredientId, fromUnit, toUnit])
  @@index([organizationId, ingredientId])
  @@index([recipeId])
}
