# build
dist/
coverage/
*.tsbuildinfo

# env — only .env.example is committed
.env
.env.*
!.env.example

# generated Prisma client (Prisma 7 emits it into src/generated)
src/generated/

# misc
# No trailing slash: with one the rule matches directories only, and a symlink
# named node_modules would be offered to git as a normal file
node_modules
*.log

# Local document storage (used when no S3 bucket is configured)
/.storage/
