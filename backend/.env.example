# Nexus backend — environment variables.
# Copy to .env and fill in. .env is never committed, and secrets never reach the
# frontend through NEXT_PUBLIC_* — they live here only.

NODE_ENV=development
PORT=8000

# Postgres (docker-compose.yml provides the nexus user, password and database)
DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus

# Redis — idle until the AI processing queues arrive in Sprint 3
REDIS_URL=redis://localhost:6379

# JWT: two separate secrets (access must differ from refresh).
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: the frontend origin. Cookie auth requires an exact origin, not *.
FRONTEND_ORIGIN=http://localhost:3000

# Document storage. An empty S3_BUCKET means a local directory (development);
# when set, uploads go to S3 and the usual AWS environment credentials apply.
S3_BUCKET=
AWS_REGION=us-east-1
STORAGE_LOCAL_DIR=./.storage

# Transactional email. Empty means nothing is sent: invitations and password
# resets are still created, and the API returns the link so it can be shared by
# hand. Set this once a provider is in place.
MAIL_PROVIDER_URL=

# Crash reporting. Empty means structured logging only.
BUGSNAG_API_KEY=
APP_VERSION=
