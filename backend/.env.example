# Nexus backend: environment variables.
# Copy to .env and fill in. .env is never committed, and secrets never reach the
# frontend through NEXT_PUBLIC_*; they live here only.

NODE_ENV=development
# The environment's name: development, staging or production. Staging runs with
# NODE_ENV=production and APP_ENV=staging; only production accepts a live Stripe key.
APP_ENV=development
PORT=8000

# Postgres (docker-compose.yml provides the nexus user, password and database)
DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus

# Redis: the document-processing queue. Validated as a URL only: with an
# unreachable Redis the API still starts and uploads wait in the queue, so check
# it by uploading a document, not by /health.
REDIS_URL=redis://localhost:6379

# JWT: two separate secrets (access must differ from refresh).
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: the frontend origin. Cookie auth requires an exact origin, not *.
FRONTEND_ORIGIN=http://localhost:3000
# Attempts per minute from one address on sign-in, registration, password reset and accepting an
# invitation. On everywhere except development; set on or off to decide it.
# AUTH_RATE_LIMIT=on
# Proxies in front of the API (Coolify's Traefik, a load balancer), so the address counted is the client's.
TRUST_PROXY=1

# Document storage. "local" keeps files in STORAGE_LOCAL_DIR; "s3" sends them to
# S3_BUCKET with the usual AWS environment credentials. Left empty, S3_BUCKET
# decides. S3_ENDPOINT points at an S3-compatible store instead of Amazon S3 -
# MinIO locally: `docker compose --profile s3 up -d`, http://localhost:9000,
# S3_FORCE_PATH_STYLE=true, AWS_ACCESS_KEY_ID=nexus, AWS_SECRET_ACCESS_KEY=nexus_dev_s3.
STORAGE_PROVIDER=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
STORAGE_LOCAL_DIR=./.storage

# Document extraction. "stub" (the default) uses a deterministic stand-in and
# calls no external service; tests and CI run on it. "gemini" (or "ai") sends
# non-tabular documents to Gemini and needs GEMINI_API_KEY; "claude" sends them
# to Claude and needs ANTHROPIC_API_KEY; "pair" has Gemini write a draft with
# GEMINI_DRAFT_MODEL and check it with GEMINI_REVIEW_MODEL, on GEMINI_API_KEY.
# A real provider without its key stops
# the API at start. Spreadsheets are parsed locally in every mode.
DOCUMENT_EXTRACTOR=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low, medium or high
ANTHROPIC_EFFORT=low

# Transactional email. "none" sends nothing: invitations are still created and
# the API returns their link so an administrator can pass it on, and a password
# reset issued by an administrator from the Team screen returns its link the same
# way; a reset a person requests for themselves reaches them only by mail. Set
# "resend" plus a key
# to deliver for real. MAIL_FROM must be an address on a domain verified with the
# provider.
MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=

# Subscription billing. "stub" (the default) is a provider whose checkout always
# succeeds and whose webhook accepts events signed with BILLING_WEBHOOK_SECRET
# (HMAC-SHA256 of the body in the stripe-signature header) - tests and the stand
# run on it. "stripe" needs the secret key, the webhook signing secret and one
# price id per paid plan; the code is the same, only the provider changes.
# BILLING_PER_LOCATION=true bills one seat per active restaurant location.
# BILLING_GRACE_DAYS is how long a past-due account keeps writing before it is
# restricted to reading.
BILLING_PROVIDER=stub
BILLING_WEBHOOK_SECRET=
BILLING_PER_LOCATION=false
BILLING_GRACE_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Crash reporting. "none" logs only; "bugsnag" also reports to BugSnag and needs
# the key. Left empty, the key decides. Reports carry APP_ENV as their stage.
ERROR_REPORTER=
BUGSNAG_API_KEY=
APP_VERSION=
