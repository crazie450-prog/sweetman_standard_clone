# Nexus — frontend environment.
# Copy to `.env.local` and adjust. Do NOT commit `.env.local` or any real secrets.
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle, so no secret may
# live here. Database, AI, Stripe and AWS credentials belong to the backend.

# ---------------------------------------------------------------------------
# Backend API base URL
# ---------------------------------------------------------------------------
# The NestJS backend base URL. Keep it in sync with PORT in the backend .env.
# The UI reads and writes through this API only; there is no offline data source.
NEXT_PUBLIC_API_URL=http://localhost:8000
